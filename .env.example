# Deployer key. Signs the deploy and the first quote registration, then hands the directory to the operator.
DEPLOYER_KEY=

# Upgrade authority: launcher and directory admin, locker and registry owner.
HYDROPUMP_ADMIN=

# Owns the buyback and reward distributor, which cannot be upgraded. Defaults to HYDROPUMP_ADMIN.
HYDROPUMP_OWNER=

# Backend key that runs the crons: buyback and distributor operator, and directory owner once handed over.
HYDROPUMP_OPERATOR=

# Bribe contract of the Hydropump gauge (vAMM-HPONE/HPTWO). Defaults to the deployed one.
HYDROPUMP_GAUGE_BRIBE=0xAb444e493d0e6E03d1ce9353956e0E4ad2ff1642

# Deployed launcher, used by the quote-token scripts.
LAUNCHER_ADDRESS=

# Deployed pair directory — where the quote whitelist and daily start ticks live.
# This is what the quote scripts write to.
PAIR_DIRECTORY_ADDRESS=

BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=
