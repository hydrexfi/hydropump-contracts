# Deployer key. This address is also the operator: it owns the launcher, refreshes start ticks,
# and runs the buyback job.
DEPLOYER_KEY=

# Safe holding everything important: upgrade authority on the launcher, owner of the locker and buyback.
HYDROPUMP_ADMIN=

# Bribe contract of the Hydropump gauge (vAMM-HPONE/HPTWO). Defaults to the deployed one.
HYDROPUMP_GAUGE_BRIBE=0xAb444e493d0e6E03d1ce9353956e0E4ad2ff1642

# Deployed launcher, used by the quote-token scripts.
LAUNCHER_ADDRESS=

BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=

